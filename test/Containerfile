# stormlb's test container, per stormcentral docs/test-standard.md. The
# runner runs test/build.sh first, which builds the static (musl) binary
# into test/out/test, then builds this with the repo root as the context and
# no build-args (so SUITE/COMMIT below keep their defaults), and starts
# `/test <suite>` with STORM_SUITE set. By hand:
#
#   test/build.sh
#   podman build -f test/Containerfile --build-arg SUITE=short \
#     --build-arg COMMIT=$(git rev-parse HEAD) -t stormlb-test-short .
#
# The binary needs nothing under it, so the image is scratch: it verifies
# the apiserver with the ServiceAccount's mounted ca.crt, not a trust store.
# What the suites need of the node (hostNetwork, the nodes read) is in
# test/requires.toml.
FROM scratch
ARG SUITE=short
ARG COMMIT=unknown
LABEL storm.io/test-of="stormlb" storm.io/test-commit="${COMMIT}" storm.io/test-suite="${SUITE}"
# The runner sets STORM_SUITE; this is the image's own suite when it does not.
ENV STORM_SUITE=${SUITE}
COPY test/out/test /test
ENTRYPOINT ["/test"]
